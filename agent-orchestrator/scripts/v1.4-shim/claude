#!/usr/bin/env bash
# v1.4.0 strips USER from the agent's env; without it claude on macOS cannot find its sign-in.
# Restore it (as v1.9.0 does in subscription mode) and keep everything else the engine passed.
# REAL_CLAUDE: the real binary (this wrapper sits first on PATH).
export USER=${USER:-$(id -un)}
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 DISABLE_TELEMETRY=1 DISABLE_ERROR_REPORTING=1 DISABLE_AUTOUPDATER=1
exec "${REAL_CLAUDE:?set REAL_CLAUDE to the claude binary}" "$@"
