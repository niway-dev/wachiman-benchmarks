      "confidence": "medium",
      "title": "Missing @Override on shouldShowWebAuthnAuthenticators",
      "body": "This overrides the protected method added in WebAuthnAuthenticator. Add `@Override` so a signature drift is caught by the compiler.",
      "anchor": "diff"
    }
