<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily field run. Install: copy to ~/Library/LaunchAgents/ with HOME_DIR replaced, then
     `launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.niway.wachi-field.plist`.
     Remove: `launchctl bootout gui/$(id -u)/dev.niway.wachi-field` and delete the file. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.niway.wachi-field</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>HOME_DIR/.wachiman-field/benchmarks/2026-11-field-kaipu/harness/field-run.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>HOME_DIR/.wachiman-field/logs/field-run.log</string>
  <key>StandardErrorPath</key><string>HOME_DIR/.wachiman-field/logs/field-run.log</string>
</dict>
</plist>
